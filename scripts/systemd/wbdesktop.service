[Unit]
Description=WorkBuddy Remote desktop session (Xvfb + openbox + VNC)
Documentation=https://github.com/USER/workbuddy-remote
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
Environment=HOME=__HOME__
Environment=LANG=zh_CN.UTF-8
Environment=LC_ALL=zh_CN.UTF-8
Environment=XDG_RUNTIME_DIR=/run/user/%U
WorkingDirectory=__APPDIR__
ExecStart=/bin/sh __APPDIR__/start-wb.sh
# 会话里的 Xvfb/x11vnc/websockify/fcitx5 都是 ExecStart 的子进程
KillMode=control-group
Restart=always
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
